# Port the API listens on
PORT=4000
# Comma-separated list of site origins allowed to call the API
WEB_ORIGIN=http://localhost:3000,https://www.my-potentia.com

# Where enquiries are delivered
MAIL_TO=info@my-potentia.com
MAIL_FROM="Potentia Website <no-reply@my-potentia.com>"

# SMTP account (e.g. Microsoft 365, Google Workspace, Amazon SES, SendGrid SMTP).
# Leave SMTP_HOST empty in development: enquiries are then printed to the console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
