# Public URL of the site (used for metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.my-potentia.com
# Optional: separate NestJS enquiry API. Leave empty to use the built-in /api/enquiries route.
NEXT_PUBLIC_API_URL=
# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_ID=G-6HBDQBXYDC
# Optional: verification codes from Google Search Console and Facebook Business Manager
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=
# Meta (Facebook / Instagram) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=1836827924179853

# ---- Enquiry & demo-request emails ----------------------------------------
# Every form on the site (Book a demo, Request a demo, Send enquiry, Contact) is emailed to MAIL_TO.
MAIL_TO=info@my-potentia.com
MAIL_FROM="Potentia Website <info@my-potentia.com>"
# Send the visitor a short "thank you, we received your request" email (true/false)
MAIL_ACK=true
# SMTP account for info@my-potentia.com. Examples:
#   Microsoft 365:     SMTP_HOST=smtp.office365.com  SMTP_PORT=587 SMTP_SECURE=false
#   Google Workspace:  SMTP_HOST=smtp.gmail.com      SMTP_PORT=465 SMTP_SECURE=true (use an App Password)
#   GoDaddy / cPanel:  use the SMTP host your mail provider gives you
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Leave NEXT_PUBLIC_API_URL empty to use the website's own /api/enquiries route (recommended).
# Set it only if you deploy the separate NestJS API in apps/api.
# Safety net while SMTP is not set up: forms are relayed through FormSubmit to info@my-potentia.com.
# Set to an empty value to turn the safety net off.
NEXT_PUBLIC_FORM_FALLBACK=https://formsubmit.co/ajax/info@my-potentia.com
